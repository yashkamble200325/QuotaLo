rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function authEmail() {
      return request.auth.token.get('email', '');
    }
    
    function isAdmin() {
      return isAuthenticated() && authEmail() == 'yashkamble200325@gmail.com';
    }
    
    function isDealer() {
      return isAuthenticated() && 
             authEmail() != 'yashkamble200325@gmail.com' && 
             authEmail().matches('(?i).*@quotalo\\.com$');
    }
    
    // Admin has full access to everything
    match /{document=**} {
      allow read, write: if isAdmin();
    }
    
    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (isAdmin() || userId == request.auth.uid || userId == authEmail());
      allow update: if isAuthenticated() && (isAdmin() || userId == request.auth.uid || userId == authEmail());
      allow delete: if isAdmin();
    }
    
    // Dealers collection
    match /dealers/{dealerId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      allow update: if isAdmin() || (isDealer() && (resource.data.email == authEmail() || dealerId == authEmail()));
      allow delete: if isAdmin();
    }
    
    // Cars, Bookings, Quotations, Test Drives - allow authenticated users
    match /cars/{carId} { 
      allow read, create, update: if isAuthenticated(); 
      allow delete: if isAdmin(); 
    }
    match /bookings/{bookingId} { 
      allow read, create, update: if isAuthenticated(); 
      allow delete: if isAdmin(); 
    }
    match /quotations/{quotationId} { 
      allow read, create, update: if isAuthenticated(); 
      allow delete: if isAdmin(); 
    }
    match /test_drives/{testDriveId} { 
      allow read, create, update: if isAuthenticated(); 
      allow delete: if isAdmin(); 
    }
  }
}
